# Rust often needs a bit of an extra main task stack size compared to C (the default is 3K)
# You might have to increase this further if you allocate large stack variables in the main task
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Increase a bit these stack sizes as they are also a bit too small by default
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_IDLE_TASK_STACKSIZE=4096

# You might have to increase this further if you spawn your own Rust threads 
# that allocate large stack variables; or better yet - use 
# `std::thread::Builder::new().stack_size(XXX)` for spawning
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=4096

# Freenove ESP32-S3 WROOM (N8R8/N16R8, ESP32-S3R8): 8MB OPI PSRAM on GPIO35-37.
# Needed for the esp32-camera driver's PSRAM frame buffers (CameraConfig default).
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# TCP throughput: the 5760 B lwIP default send buffer (4*MSS) forces a ~200 KB
# VOX2 record through ~35 blocking writes; 32 KB fixes it (65535 max without
# CONFIG_LWIP_WND_SCALE). WND is this side's receive window (STRT only).
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# The release IDF C build links the new I2C driver_ng next to the legacy driver
# esp32-camera's SCCB uses, and the legacy driver aborts at boot if driver_ng is
# linked ("i2c: CONFLICT! ..."). Nothing uses both -> skip the check.
CONFIG_I2C_SKIP_LEGACY_CONFLICT_CHECK=y
