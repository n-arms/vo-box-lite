# esp-idf template
/.vscode
/.embuild
/target
/Cargo.lock

# Editor configuration
.helix/
.zed/
.nvim.lua

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Ignore .DS_Store file in mac
**/.DS_Store

# esp-idf-sys component-manager lock (like Cargo.lock, regenerated on build;
# the esp32-camera version is pinned via Cargo.toml extra_components metadata)
/components_esp32s3.lock

# Output of scripts/receive_frames.py (saved BMP frames)
/frames/

# Python bytecode cache
**/__pycache__/
